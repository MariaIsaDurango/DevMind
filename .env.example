# Copia este archivo a .env y completa los valores. NUNCA subas .env a Git.

# --- LLM ---
LLM_PROVIDER=anthropic          # anthropic | openai | ollama
LLM_MODEL=
LLM_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Vector store ---
CHROMA_PATH=./data/processed/chroma
COLLECTION_NAME=devmind_docs

# --- Retrieval ---
TOP_K=4
SIMILARITY_THRESHOLD=0.30

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Subida de documentos (POST /upload) ---
UPLOAD_DIR=./data/raw
ALLOWED_EXTENSIONS=.pdf,.md,.txt
MAX_UPLOAD_MB=20

# --- Backend / Frontend ---
BACKEND_URL=http://localhost:8000
GRADIO_PORT=7860
